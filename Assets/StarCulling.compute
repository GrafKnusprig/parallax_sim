// Star Culling Compute Shader
// Processes 2.4M stars in parallel on GPU
// Outputs visible star data for instanced rendering

#pragma kernel CullStars
#pragma kernel CopyCount

// Input star data (uploaded once)
// Uses float4 for explicit 16-byte alignment to match C# layout safely
struct StarInput
{
    float4 posAndDist;    // xyz = positionParsecs, w = distance
    float4 dirAndInvDist; // xyz = direction,       w = invDistance
};

// Output visible star data
struct StarOutput
{
    float3 worldPosition;
};

// Buffers
StructuredBuffer<StarInput> _AllStars;
AppendStructuredBuffer<StarOutput> _VisibleStars;
RWStructuredBuffer<uint> _IndirectArgs;

// Uniforms
float3 _CameraPos;
float3 _CameraForward;
float3 _PlayerPosAu;
float _HorizonRadius;
float _CosHalfFOV;
float _CosRoughFOV;
float _AuToParsec;

// Parallax settings
int _EnableParallax;
int _EnableFastParallaxApprox;
float _ParallaxApproxDistanceParsecs;

uint _StarCount;

[numthreads(256, 1, 1)]
void CullStars(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= _StarCount)
        return;
    
    StarInput star = _AllStars[id.x];
    
    float3 worldPos;
    
    // Optimized Culling Logic
    if (_EnableParallax == 0)
    {
        float3 dir = star.dirAndInvDist.xyz;
        
        // Fast Pre-Check (No Parallax)
        if (dot(dir, _CameraForward) < _CosHalfFOV)
            return;
            
        worldPos = dir * _HorizonRadius;
    }
    else
    {
        // Parallax enabled: Calculate vector P from player to star
        // P = StarPos - PlayerPos (All in Parsecs)
        float3 P = star.posAndDist.xyz - (_PlayerPosAu * _AuToParsec);
        
        // Fast Squared FOV Check
        // We defer costly sqrt/normalize until after culling
        float dotF = dot(P, _CameraForward);
        
        // 1. Cull if behind camera (assuming FOV < 180)
        if (dotF <= 0)
            return;
            
        // 2. Cull if outside field of view cone
        // Check: dot(P, F) < cos(theta) * length(P)
        // Optimization: dotF^2 < cos^2 * dot(P, P)
        float distSq = dot(P, P);
        if (dotF * dotF < (_CosHalfFOV * _CosHalfFOV) * distSq)
            return;
            
        // Star is visible: Compute final world position
        // rsqrt is fast on GPU
        float invDist = rsqrt(distSq);
        float3 dir = P * invDist;
        
        worldPos = dir * _HorizonRadius;
    }
    
    // Output visible star
    StarOutput output;
    output.worldPosition = worldPos;
    _VisibleStars.Append(output);
}

// Copy the append buffer count to indirect args
[numthreads(1, 1, 1)]
void CopyCount(uint3 id : SV_DispatchThreadID)
{
    // IndirectArgs format for DrawMeshInstancedIndirect:
    // [0] = index count per instance
    // [1] = instance count (this is what we set)
    // [2] = start index location
    // [3] = base vertex location
    // [4] = start instance location
    // The count is already in args[1] from CopyCount
}
